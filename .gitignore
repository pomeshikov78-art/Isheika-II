# Кэш интерпретатора и dev-зависимости проверок интерфейса (в рантайме не нужны)
__pycache__/
*.py[cod]
node_modules/

# Каталог сборки Windows-образа (кеш загруженного CPython)
.cache/

# Runtime-данные поверх поставленного демо-состояния:
# журнал загрузки и вновь сформированные файлы отчётов не версионируются.
var/boot-log.txt
var/boot-log.json
var/files/
var/backups/
