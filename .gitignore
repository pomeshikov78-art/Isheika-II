# Кэш интерпретатора и dev-зависимости проверок интерфейса (в рантайме не нужны)
__pycache__/
*.py[cod]
node_modules/

# Каталог сборки Windows-образа (кеш загруженного CPython)
.cache/

# Runtime-данные поверх поставленного демо-состояния:
# журнал загрузки и вновь сформированные файлы отчётов не версионируются.
var/boot-log.txt
var/boot-log.json
var/journal-fallback.log
var/files/
var/backups/

# Секреты и локальная конфигурация рабочего каталога — не публикуются никогда:
# мастер-ключ хранилища и зашифрованные ключи источников, локальный config.json,
# служебные файлы WAL рядом с демонстрационной БД.
var/secrets.enc
var/secrets.enc.master
var/config.json
var/isheika.db-shm
var/isheika.db-wal
